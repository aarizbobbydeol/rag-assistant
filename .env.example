# Copy to .env and edit. Every setting is optional: with an empty file the
# assistant runs fully offline on the built-in hashing embedder and the
# extractive answerer.

# --- service ---------------------------------------------------------------
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true
RAG_PORT=8000

# --- authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_AUTH_SECRET=change-me-before-deploying
RAG_AUTH_REQUIRED=false
RAG_AUTH_ALLOW_REGISTRATION=true

# --- language model --------------------------------------------------------
# Leave RAG_LLM_API_KEY empty for the offline extractive backend.
# OpenAI:      base_url=https://api.openai.com/v1     model=gpt-4o-mini
# Groq:        base_url=https://api.groq.com/openai/v1
# Together:    base_url=https://api.together.xyz/v1
# Ollama:      base_url=http://localhost:11434/v1     key=ollama
# vLLM:        base_url=http://localhost:8001/v1
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_PRICE_INPUT_PER_1M=0.15
RAG_LLM_PRICE_OUTPUT_PER_1M=0.60

# --- embeddings ------------------------------------------------------------
# auto | hashing | sentence-transformers | openai
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIM=1024

# --- vector store ----------------------------------------------------------
# auto | numpy | faiss | pgvector | qdrant
RAG_VECTOR_STORE=auto
RAG_PG_DSN=postgresql://rag:rag@localhost:5432/rag
RAG_QDRANT_URL=http://localhost:6333

# --- retrieval -------------------------------------------------------------
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
RAG_CANDIDATE_K=24
RAG_SPLITTER=recursive
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_RERANK_ENABLED=true
RAG_RERANK_BACKEND=auto

# --- safety ----------------------------------------------------------------
RAG_STRICT_GROUNDING=false
RAG_MIN_RETRIEVAL_SCORE=0.10
RAG_GROUNDEDNESS_THRESHOLD=0.42
RAG_MIN_ANSWER_GROUNDEDNESS=0.60
