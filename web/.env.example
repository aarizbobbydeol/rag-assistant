# Copy to `.env.local` and edit if you need to point the SPA somewhere other than
# the origin it is served from.
#
# Leave empty for local development: `npm run dev` proxies /api, /health and
# /metrics to http://localhost:8000 (see vite.config.ts), so the browser only
# ever talks to its own origin and there is no CORS handshake.
#
# Set it to an absolute origin (no trailing slash) when the built bundle is
# hosted separately from the API, e.g. https://rag.example.com
VITE_API_BASE_URL=
